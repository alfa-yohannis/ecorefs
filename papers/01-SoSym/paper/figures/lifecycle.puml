@startuml lifecycle
' UML state machine: the URI of an IPFSResourceImpl across saves.
' Internal transitions (event / effect) inside the states keep the diagram one column wide.
!include style.iuml
hide empty description
skinparam defaultFontSize 11

state "Unsaved" as Unsaved
Unsaved : URI = ipfs://pending
state "Stored by CID" as Stored
Stored : URI = ipfs://<CID>
Stored : save() / new CID, new URI
state "Published by IPNS name" as Published
Published : URI = ipns://<key id>
Published : save() / new CID, same URI

[*] -right-> Unsaved : create
Unsaved --> Stored : save()\n[CID mode]
Unsaved --> Published : save()\n[IPNS mode]
Stored -[hidden]down-> Published
@enduml
