@startuml cascade-example
' UML object diagram: the BPMN case study before and after a complete cascade save.
' The CIDs are placeholders, not real content identifiers.
!include style.iuml
skinparam defaultFontSize 11

package "Before the change" {
  object "collaboration.bpmn" as C1 {
    URI = ipfs://QmC
    refs = QmB, QmA
  }
  object "order-process.bpmn" as O1 {
    URI = ipfs://QmB
    refs = QmA
  }
  object "payment-process.bpmn" as P1 {
    URI = ipfs://QmA
  }
  C1 --> O1 : processRef
  C1 --> P1 : processRef
  O1 --> P1 : supports
}

package "After the cascade save" {
  object "collaboration.bpmn" as C2 {
    URI = ipfs://QmC'
    refs = QmB', QmA'
  }
  object "order-process.bpmn" as O2 {
    URI = ipfs://QmB'
    refs = QmA'
  }
  object "payment-process.bpmn" as P2 {
    URI = ipfs://QmA'
  }
  C2 --> O2 : processRef
  C2 --> P2 : processRef
  O2 --> P2 : supports
}
@enduml
