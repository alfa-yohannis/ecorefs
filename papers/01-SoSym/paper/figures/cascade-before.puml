@startuml cascade-before
' UML object diagram: the three BPMN resources of the case study before the change.
' The CIDs are placeholders, not real content identifiers.
' Laid out top to bottom and about one text column wide.
!include style.iuml
skinparam defaultFontSize 11
skinparam nodesep 12
skinparam ranksep 26

object "collaboration.bpmn" as C {
  URI = ipfs://QmC
  refs = QmB, QmA
}
object "order-process.bpmn" as O {
  URI = ipfs://QmB
  refs = QmA
}
object "payment-process.bpmn" as P {
  URI = ipfs://QmA
}

C --> O : processRef
C --> P : processRef
O --> P : supports
@enduml
