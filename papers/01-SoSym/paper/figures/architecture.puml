@startuml architecture
' UML class diagram: how the ecorefs core plugin extends the EMF persistence API.
' Stereotypes mark the origin of each class; the ecorefs classes also get a light fill.
' The layout follows a snake: the first row reads from left to right, the second
' row from right to left, the third row from left to right again. Hidden edges
' link the end of one row to the start of the next row.
!include style.iuml
allowmixing
hide empty members
skinparam defaultFontSize 11
skinparam nodesep 14
skinparam ranksep 24

class ResourceFactoryImpl <<EMF>>
class IPFSResourceFactoryImpl <<ecorefs>> {
  +createResource(uri)
}
class IPFSResourceImpl <<ecorefs>> {
  +save(options)
}
class XMIResourceImpl <<EMF>>
class URIHandlerImpl <<EMF>>
class IPFSURIHandlerImpl <<ecorefs>> {
  +createInputStream(uri)
}
enum ReferenceMode <<ecorefs>> {
  CID
  IPNS
}
node "IPFS node\n(Kubo)" as Kubo

' Row 1, from left to right
ResourceFactoryImpl <|-right- IPFSResourceFactoryImpl
' Row 2, from right to left
XMIResourceImpl <|-left- IPFSResourceImpl
' Row 3, from left to right
URIHandlerImpl <|-right- IPFSURIHandlerImpl

' Turns of the snake
IPFSResourceFactoryImpl -[hidden]down- XMIResourceImpl
IPFSResourceImpl -[hidden]down- URIHandlerImpl
IPFSURIHandlerImpl -[hidden]down- Kubo

IPFSResourceFactoryImpl ..> IPFSResourceImpl : <<create>>
IPFSResourceImpl ..> ReferenceMode : mode
IPFSResourceImpl --> Kubo : add,\nname/publish
IPFSURIHandlerImpl --> Kubo : cat,\nname/resolve
@enduml
