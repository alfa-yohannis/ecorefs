' Laid out top to bottom and about one text column wide.
!include style.iuml
skinparam defaultFontSize 11
skinparam nodesep 12
skinparam ranksep 26

object "collaboration.bpmn" as C {
  URI = ipfs://QmUx9A...KysJ
  refs = QmYd4B..., QmfGiC...
}
object "order-process.bpmn" as O {
  URI = ipfs://QmYd4B...sDdR
  refs = QmfGiC...
}
object "payment-process.bpmn" as P {
