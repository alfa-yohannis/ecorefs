@startuml lifecycle
' UML state machine: the URI of an IPFSResourceImpl across publications.
' Internal transitions (event / effect) inside the states keep the diagram one column wide.
!include style.iuml
hide empty description
skinparam defaultFontSize 11

state "Unpublished" as Unsaved
Unsaved : URI = local file or ipfs://pending
Unsaved : save() / writes the local file
state "Stored by CID" as Stored
Stored : URI = ipfs://<CID>
Stored : saveIPFS() / new CID, new URI
state "Published by IPNS name" as Published
Published : URI = ipns://<key id>
Published : saveIPFS() / new CID, same URI

[*] -down-> Unsaved : create
Unsaved -right-> Stored : saveIPFS()\n[CID mode]
Unsaved -up-> Published : saveIPFS()\n[IPNS mode]
Published -[hidden]down-> Stored
@enduml
